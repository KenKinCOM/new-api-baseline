# New-API 生产环境变量模板（C-03 / C-05 / C-09）
#
# 用法：
#   cp deploy/env.production.example .env      # docker compose 自动读取
#   chmod 600 .env
# 所有 `:?` 语义的变量在 docker-compose.yml 里是强制项，缺失即 `docker compose up` 失败。
# 口令生成：openssl rand -hex 32

# ── 镜像 ────────────────────────────────────────────────────────────────
# 必须是本仓构建出来的 tag 或 digest；禁止 calciumion/new-api:latest
NEW_API_IMAGE=registry.example.internal/ai-gateway/new-api:0.2.0
NEW_API_REPLICAS=2

# ── 数据库 ──────────────────────────────────────────────────────────────
# 生产接 RDS，SQLite 仅 POC（T4 §4.5 #8）。示例：
# SQL_DSN=newapi:${DB_PASSWORD}@tcp(rm-xxxx.mysql.rds.aliyuncs.com:3306)/new_api?charset=utf8mb4&parseTime=True&loc=Local
POSTGRES_USER=newapi
POSTGRES_PASSWORD=__REPLACE_ME__
POSTGRES_DB=new-api

# ── Redis（可选，代码里 REDIS_CONN_STRING 为空即关闭；多实例才需要）────
REDIS_PASSWORD=__REPLACE_ME__

# ── 信任代理（C-09，必填）───────────────────────────────────────────────
# ALB / Nginx 所在网段；直连暴露写 none。不填则启动失败（TRUSTED_PROXIES_REQUIRED=true）
TRUSTED_PROXIES=172.20.0.0/16
TRUSTED_PROXIES_REQUIRED=true

# ── 日志轮转（C-06）─────────────────────────────────────────────────────
LOG_MAX_SIZE_MB=200
LOG_RETENTION_DAYS=14
# 目录内最多保留多少个历史文件，0=不按个数限制（只按天数/大小）
LOG_MAX_BACKUPS=0
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=5

# ── 资源上限（C-04）─────────────────────────────────────────────────────
NEW_API_CPU_LIMIT=2
NEW_API_MEM_LIMIT=2g
NEW_API_MEM_RESERVATION=512m
REDIS_CPU_LIMIT=1
REDIS_MEM_LIMIT=512m
POSTGRES_CPU_LIMIT=2
POSTGRES_MEM_LIMIT=2g

# ── 其它 ────────────────────────────────────────────────────────────────
TZ=Asia/Shanghai
NODE_NAME=new-api-node-1
# pprof 必须保持 false（C-10）；排障窗口临时开时只绑回环：PPROF_ADDR=127.0.0.1:8005
ENABLE_PPROF=false

# ── 密钥：不要写在这里，走文件 ──────────────────────────────────────────
# docker-compose.yml 已把 ./secrets:/run/secrets:ro 挂进容器并设置
#   SESSION_SECRET_FILE=/run/secrets/session_secret
#   CRYPTO_SECRET_FILE=/run/secrets/crypto_secret
# 生成：
#   mkdir -p secrets
#   openssl rand -hex 32 > secrets/session_secret
#   openssl rand -hex 32 > secrets/crypto_secret
#   chmod 400 secrets/*  &&  chown 10001:10001 secrets/*
#
# 注意：SESSION_SECRET 一旦更换，所有用户会话与 refresh token 立即失效。
# 首次上线随机生成后必须备份到 KMS/密码库，不能只留在机器上。